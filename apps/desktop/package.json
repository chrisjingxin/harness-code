{
  "name": "@workbench/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview --skipBuild",
    "dev:ui-preview": "node ../../scripts/workbench/ui-preview.mjs hc205 dev",
    "build:ui-preview": "node ../../scripts/workbench/ui-preview.mjs hc205 build",
    "preview:ui": "node ../../scripts/workbench/ui-preview.mjs hc205 preview",
    "dev:conversation-preview": "node ../../scripts/workbench/ui-preview.mjs hc206 dev",
    "build:conversation-preview": "node ../../scripts/workbench/ui-preview.mjs hc206 build",
    "preview:conversation": "node ../../scripts/workbench/ui-preview.mjs hc206 preview",
    "dev:project-preview": "node ../../scripts/workbench/ui-preview.mjs hc207 dev",
    "build:project-preview": "node ../../scripts/workbench/ui-preview.mjs hc207 build",
    "preview:project": "node ../../scripts/workbench/ui-preview.mjs hc207 preview",
    "dev:navigation-preview": "node ../../scripts/workbench/ui-preview.mjs hc217 dev",
    "build:navigation-preview": "node ../../scripts/workbench/ui-preview.mjs hc217 build",
    "preview:navigation": "node ../../scripts/workbench/ui-preview.mjs hc217 preview"
  },
  "dependencies": {
    "@workbench/contracts": "0.2.0",
    "@workbench/ui": "0.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tough-cookie": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.3",
    "electron-vite": "6.0.0",
    "vite": "8.3.6",
    "@vitejs/plugin-react": "6.2.1"
  },
  "main": "dist/main/index.js"
}
