# 协议 Schema 与双端生成产物必须固定 LF 换行：
# Python sidecar 按原始字节计算 protocol_v3.json 的 sha256 摘要，
# Windows 上 autocrlf 检出 CRLF 会导致摘要漂移、sidecar 启动即崩溃。
packages/protocol/schema/v3.json text eol=lf
packages/protocol/src/generated.ts text eol=lf
packages/protocol/fixtures/v3-contract.json text eol=lf
packages/agent/harness_agent/protocol/protocol_v3.json text eol=lf
packages/agent/harness_agent/protocol/protocol_v3.sha256 text eol=lf
packages/agent/harness_agent/protocol/generated.py text eol=lf

# 精确 npm 发布目录保留上游文件字节（其中可能有文档表格或模板字面量的尾随空格）；
# provenance 目录摘要负责完整性校验，避免通用 diff 门禁把上游原始内容误报为错误。
third_party/npm/** whitespace=-trailing-space
