    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "3.23.0",
    "string-width": "8.2.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.11",
    "@types/node": "20.19.35",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
