{
  "openapi": "3.1.0",
  "info": {
    "title": "独立工作台项目组织契约",
    "version": "1"
  },
  "paths": {
    "/api/v1/workspaces/{workspaceId}/projects": {
      "get": {
        "operationId": "get__projects",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "调用者以活跃成员身份参与的项目列表",
            "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/ProjectListResponse" } } }
          },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      },
      "post": {
        "operationId": "post__projects",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/ProjectCreateRequest" } } }
        },
        "responses": {
          "201": {
            "description": "项目已创建",
            "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/ProjectResponse" } } }
          },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/projects/{projectId}": {
      "get": {
        "operationId": "get__project",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "项目详情（成员与仓库引用）",
            "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/ProjectDetailResponse" } } }
          },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      },
      "patch": {
        "operationId": "patch__project",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/ProjectPatchRequest" } } }
        },
        "responses": {
          "200": {
            "description": "项目已更新（版本+1）",
            "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/ProjectResponse" } } }
          },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/projects/{projectId}/members": {
      "get": {
        "operationId": "get__project_members",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "项目成员列表（含已移出）",
            "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/ProjectMemberListResponse" } } }
          },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      },
      "post": {
        "operationId": "post__project_members",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/ProjectMemberAddRequest" } } }
        },
        "responses": {
          "200": {
            "description": "成员已加入或已存在",
            "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/ProjectMemberChangeResponse" } } }
          },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/projects/{projectId}/members/{userId}": {
      "delete": {
        "operationId": "delete__project_member",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "成员已置为 removed",
            "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/ProjectMemberChangeResponse" } } }
          },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/repositories": {
      "get": {
        "operationId": "get__repositories",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "团队仓库目录",
            "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/RepositoryListResponse" } } }
          },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      },
      "post": {
        "operationId": "post__repositories",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/RepositoryCreateRequest" } } }
        },
        "responses": {
          "201": {
            "description": "仓库已登记",
            "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/RepositorySummary" } } }
          },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/repositories/{repositoryId}": {
      "get": {
        "operationId": "get__repository",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "repositoryId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "仓库详情与引用它的项目",
            "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/RepositoryDetailResponse" } } }
          },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      },
      "patch": {
        "operationId": "patch__repository",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "repositoryId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/RepositoryPatchRequest" } } }
        },
        "responses": {
          "200": {
            "description": "仓库已更新",
            "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/RepositorySummary" } } }
          },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/projects/{projectId}/repositories": {
      "get": {
        "operationId": "get__project_repositories",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "项目仓库引用与调用者本机克隆",
            "content": { "application/json": { "schema": { "$ref": "../schema/organization.schema.json#/$defs/ProjectRepositoryListResponse" } } }
          },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/projects/{projectId}/repositories/{repositoryId}": {
      "put": {
        "operationId": "put__project_repository",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "repositoryId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "引用已建立或已存在" },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      },
      "delete": {
        "operationId": "delete__project_repository",
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "repositoryId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "引用已移除" },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/device/repo-bindings/{repositoryId}": {
      "put": {
        "operationId": "put__repo_binding",
        "parameters": [
          { "name": "repositoryId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "本机仓库已登记" },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      },
      "delete": {
        "operationId": "delete__repo_binding",
        "parameters": [
          { "name": "repositoryId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "本机仓库登记已移除" },
          "default": {
            "description": "安全错误",
            "content": { "application/json": { "schema": { "$ref": "../schema/platform.schema.json#/$defs/ErrorResponse" } } }
          }
        }
      }
    }
  }
}
