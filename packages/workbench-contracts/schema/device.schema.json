{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schema/device.schema.json",
  "$defs": {
    "ConnectionState": {
      "type": "string",
      "enum": ["offline", "reconciling", "ready"]
    },
    "AgentConfigSummary": {
      "type": "object",
      "properties": {
        "agentConfigId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "available": { "type": "boolean" }
      },
      "required": ["agentConfigId", "name", "available"],
      "additionalProperties": false
    },
    "AgentConfigList": {
      "type": "array",
      "items": { "$ref": "#/$defs/AgentConfigSummary" },
      "maxItems": 50
    },
    "DeviceSummary": {
      "type": "object",
      "properties": {
        "deviceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "workspaceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "ownerUserId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "revokedAt": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" }
          ]
        },
        "connectionState": { "$ref": "#/$defs/ConnectionState" },
        "lastSeenAt": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" }
          ]
        }
      },
      "required": ["deviceId", "workspaceId", "ownerUserId", "name", "createdAt", "revokedAt", "connectionState", "lastSeenAt"],
      "additionalProperties": false
    },
    "ProjectSummary": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "deviceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "workspaceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "shareEnabled": { "type": "boolean" },
        "shareVersion": { "$ref": "https://workbench.invalid/schema/conversation.schema.json#/$defs/ShareVersion" },
        "createdAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "updatedAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "agentConfigs": { "$ref": "#/$defs/AgentConfigList" }
      },
      "required": ["projectId", "deviceId", "workspaceId", "name", "shareEnabled", "shareVersion", "createdAt", "updatedAt", "agentConfigs"],
      "additionalProperties": false
    },
    "DeviceSecret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "DeviceRegistrationRequest": {
      "type": "object",
      "properties": {
        "registrationId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "deviceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "installationId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "ledgerId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "secret": { "$ref": "#/$defs/DeviceSecret" }
      },
      "required": ["registrationId", "deviceId", "installationId", "ledgerId", "name", "secret"],
      "additionalProperties": false
    },
    "DeviceRegistrationResponse": {
      "type": "object",
      "properties": {
        "registrationId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "device": { "$ref": "#/$defs/DeviceSummary" }
      },
      "required": ["registrationId", "device"],
      "additionalProperties": false
    },
    "DevicePageCursor": {
      "type": "object",
      "properties": {
        "beforeCreatedAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "beforeDeviceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
      },
      "required": ["beforeCreatedAt", "beforeDeviceId"],
      "additionalProperties": false
    },
    "DeviceListResponse": {
      "type": "object",
      "properties": {
        "workspaceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "devices": {
          "type": "array",
          "items": { "$ref": "#/$defs/DeviceSummary" },
          "maxItems": 100
        },
        "nextPage": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/DevicePageCursor" }
          ]
        }
      },
      "required": ["workspaceId", "devices", "nextPage"],
      "additionalProperties": false
    },
    "DeviceRevokeRequest": {
      "type": "object",
      "properties": {
        "requestId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
      },
      "required": ["requestId"],
      "additionalProperties": false
    },
    "DeviceRevokedResponse": {
      "type": "object",
      "properties": {
        "deviceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "revokedAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" }
      },
      "required": ["deviceId", "revokedAt"],
      "additionalProperties": false
    },
    "ProjectPageCursor": {
      "type": "object",
      "properties": {
        "beforeCreatedAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "beforeProjectId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
      },
      "required": ["beforeCreatedAt", "beforeProjectId"],
      "additionalProperties": false
    },
    "ProjectListResponse": {
      "type": "object",
      "properties": {
        "workspaceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "deviceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "projects": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProjectSummary" },
          "maxItems": 100
        },
        "nextPage": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/ProjectPageCursor" }
          ]
        }
      },
      "required": ["workspaceId", "deviceId", "projects", "nextPage"],
      "additionalProperties": false
    },
    "ProjectStopSharingRequest": {
      "type": "object",
      "properties": {
        "requestId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "expectedShareVersion": { "$ref": "https://workbench.invalid/schema/conversation.schema.json#/$defs/ShareVersion" }
      },
      "required": ["requestId", "expectedShareVersion"],
      "additionalProperties": false
    },
    "DeviceProjectPublishRequest": {
      "type": "object",
      "properties": {
        "requestId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "projectId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "shareEnabled": { "type": "boolean" },
        "expectedShareVersion": { "$ref": "https://workbench.invalid/schema/conversation.schema.json#/$defs/ShareVersion" },
        "agentConfigs": { "$ref": "#/$defs/AgentConfigList" }
      },
      "required": ["requestId", "projectId", "name", "shareEnabled", "expectedShareVersion", "agentConfigs"],
      "additionalProperties": false
    },
    "ProjectSavedResponse": {
      "type": "object",
      "properties": {
        "requestId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "project": { "$ref": "#/$defs/ProjectSummary" }
      },
      "required": ["requestId", "project"],
      "additionalProperties": false
    },
    "DeviceWelcomePayload": {
      "type": "object",
      "properties": {
        "deviceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "workspaceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "ownerUserId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "ledgerId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "resumeId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "heartbeatIntervalMs": { "const": 15000, "type": "integer" },
        "heartbeatTimeoutMs": { "const": 45000, "type": "integer" }
      },
      "required": ["deviceId", "workspaceId", "ownerUserId", "ledgerId", "resumeId", "heartbeatIntervalMs", "heartbeatTimeoutMs"],
      "additionalProperties": false
    },
    "DeviceWelcomeMessage": {
      "type": "object",
      "properties": {
        "protocolVersion": { "const": 1, "type": "integer" },
        "messageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "type": { "const": "device.welcome", "type": "string" },
        "occurredAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "payload": { "$ref": "#/$defs/DeviceWelcomePayload" }
      },
      "required": ["protocolVersion", "messageId", "type", "occurredAt", "payload"],
      "additionalProperties": false
    },
    "ResumeInventoryRequestPayload": {
      "type": "object",
      "properties": {
        "resumeId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "kind": { "const": "inventory", "type": "string" },
        "afterStartCommandId": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
          ]
        }
      },
      "required": ["resumeId", "kind", "afterStartCommandId"],
      "additionalProperties": false
    },
    "ResumeLookupRequestPayload": {
      "type": "object",
      "properties": {
        "resumeId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "kind": { "const": "lookup", "type": "string" },
        "startCommandId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
      },
      "required": ["resumeId", "kind", "startCommandId"],
      "additionalProperties": false
    },
    "DeviceResumeRequestMessage": {
      "type": "object",
      "properties": {
        "protocolVersion": { "const": 1, "type": "integer" },
        "messageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "type": { "const": "device.resume.request", "type": "string" },
        "occurredAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "payload": {
          "oneOf": [
            { "$ref": "#/$defs/ResumeInventoryRequestPayload" },
            { "$ref": "#/$defs/ResumeLookupRequestPayload" }
          ]
        }
      },
      "required": ["protocolVersion", "messageId", "type", "occurredAt", "payload"],
      "additionalProperties": false
    },
    "LocalExecutionRecord": {
      "type": "object",
      "properties": {
        "kind": { "const": "execution", "type": "string" },
        "start": { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/ExecutionStartMessage" },
        "decision": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/ExecutionStartDecisionMessage" }
          ]
        },
        "cancel": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/ExecutionCancelMessage" }
          ]
        },
        "localState": { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/RecoveryLocalState" },
        "lastRunnerSequence": { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/RunnerSequence" },
        "lastCommittedRunnerSequence": { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/RunnerSequence" },
        "nativeSessionId": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/NativeSessionId" }
          ]
        },
        "terminal": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/ExecutionTerminalMessage" }
          ]
        }
      },
      "required": ["kind", "start", "decision", "cancel", "localState", "lastRunnerSequence", "lastCommittedRunnerSequence", "nativeSessionId", "terminal"],
      "additionalProperties": false
    },
    "CancelBeforeStartRecord": {
      "type": "object",
      "properties": {
        "kind": { "const": "cancelBeforeStart", "type": "string" },
        "cancel": { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/ExecutionCancelMessage" },
        "lastRunnerSequence": { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/RunnerSequence" },
        "lastCommittedRunnerSequence": { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/RunnerSequence" },
        "terminal": { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/ExecutionTerminalMessage" }
      },
      "required": ["kind", "cancel", "lastRunnerSequence", "lastCommittedRunnerSequence", "terminal"],
      "additionalProperties": false
    },
    "ResumeRecord": {
      "oneOf": [
        { "$ref": "#/$defs/LocalExecutionRecord" },
        { "$ref": "#/$defs/CancelBeforeStartRecord" }
      ]
    },
    "DeviceResumeMessage": {
      "type": "object",
      "properties": {
        "protocolVersion": { "const": 1, "type": "integer" },
        "messageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "type": { "const": "device.resume", "type": "string" },
        "occurredAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "payload": {
          "type": "object",
          "properties": {
            "resumeId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
            "requestMessageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
            "ledgerId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
            "afterStartCommandId": {
              "anyOf": [
                { "type": "null" },
                { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
              ]
            },
            "records": {
              "type": "array",
              "items": { "$ref": "#/$defs/ResumeRecord" },
              "maxItems": 100
            },
            "nextAfterStartCommandId": {
              "anyOf": [
                { "type": "null" },
                { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
              ]
            }
          },
          "required": ["resumeId", "requestMessageId", "ledgerId", "afterStartCommandId", "records", "nextAfterStartCommandId"],
          "additionalProperties": false
        }
      },
      "required": ["protocolVersion", "messageId", "type", "occurredAt", "payload"],
      "additionalProperties": false
    },
    "DeviceCommandStatusFoundPayload": {
      "type": "object",
      "properties": {
        "resumeId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "requestMessageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "ledgerId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "startCommandId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "result": { "const": "found", "type": "string" },
        "record": { "$ref": "#/$defs/ResumeRecord" }
      },
      "required": ["resumeId", "requestMessageId", "ledgerId", "startCommandId", "result", "record"],
      "additionalProperties": false
    },
    "DeviceCommandStatusNotFoundPayload": {
      "type": "object",
      "properties": {
        "resumeId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "requestMessageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "ledgerId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "startCommandId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "result": { "const": "notFound", "type": "string" }
      },
      "required": ["resumeId", "requestMessageId", "ledgerId", "startCommandId", "result"],
      "additionalProperties": false
    },
    "DeviceCommandStatusMessage": {
      "type": "object",
      "properties": {
        "protocolVersion": { "const": 1, "type": "integer" },
        "messageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "type": { "const": "device.command.status", "type": "string" },
        "occurredAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "payload": {
          "oneOf": [
            { "$ref": "#/$defs/DeviceCommandStatusFoundPayload" },
            { "$ref": "#/$defs/DeviceCommandStatusNotFoundPayload" }
          ]
        }
      },
      "required": ["protocolVersion", "messageId", "type", "occurredAt", "payload"],
      "additionalProperties": false
    },
    "DeviceProjectChangedMessage": {
      "type": "object",
      "properties": {
        "protocolVersion": { "const": 1, "type": "integer" },
        "messageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "type": { "const": "device.project.changed", "type": "string" },
        "occurredAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "payload": {
          "type": "object",
          "properties": {
            "resumeId": {
              "anyOf": [
                { "type": "null" },
                { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
              ]
            },
            "projectId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
            "shareEnabled": { "type": "boolean" },
            "shareVersion": { "$ref": "https://workbench.invalid/schema/conversation.schema.json#/$defs/ShareVersion" }
          },
          "required": ["resumeId", "projectId", "shareEnabled", "shareVersion"],
          "additionalProperties": false
        }
      },
      "required": ["protocolVersion", "messageId", "type", "occurredAt", "payload"],
      "additionalProperties": false
    },
    "DeviceProjectSavedMessage": {
      "type": "object",
      "properties": {
        "protocolVersion": { "const": 1, "type": "integer" },
        "messageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "type": { "const": "device.project.saved", "type": "string" },
        "occurredAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "payload": {
          "type": "object",
          "properties": {
            "resumeId": {
              "anyOf": [
                { "type": "null" },
                { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
              ]
            },
            "requestMessageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
            "projectId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
            "shareVersion": { "$ref": "https://workbench.invalid/schema/conversation.schema.json#/$defs/ShareVersion" },
            "result": { "type": "string", "enum": ["applied", "notRegistered"] }
          },
          "required": ["resumeId", "requestMessageId", "projectId", "shareVersion", "result"],
          "additionalProperties": false
        }
      },
      "required": ["protocolVersion", "messageId", "type", "occurredAt", "payload"],
      "additionalProperties": false
    },
    "DeviceReadyMessage": {
      "type": "object",
      "properties": {
        "protocolVersion": { "const": 1, "type": "integer" },
        "messageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "type": { "const": "device.ready", "type": "string" },
        "occurredAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "payload": {
          "type": "object",
          "properties": {
            "resumeId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
            "ledgerId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
          },
          "required": ["resumeId", "ledgerId"],
          "additionalProperties": false
        }
      },
      "required": ["protocolVersion", "messageId", "type", "occurredAt", "payload"],
      "additionalProperties": false
    },
    "DeviceExecutionProblemMessage": {
      "type": "object",
      "properties": {
        "protocolVersion": { "const": 1, "type": "integer" },
        "messageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "type": { "const": "device.execution.problem", "type": "string" },
        "occurredAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "payload": { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/ExecutionProblem" }
      },
      "required": ["protocolVersion", "messageId", "type", "occurredAt", "payload"],
      "additionalProperties": false
    },
    "DeviceProblemMessage": {
      "type": "object",
      "properties": {
        "protocolVersion": { "const": 1, "type": "integer" },
        "messageId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "type": { "const": "device.problem", "type": "string" },
        "occurredAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "payload": {
          "type": "object",
          "properties": {
            "resumeId": {
              "anyOf": [
                { "type": "null" },
                { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
              ]
            },
            "requestMessageId": {
              "anyOf": [
                { "type": "null" },
                { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
              ]
            },
            "code": {
              "type": "string",
              "enum": ["INVALID_CONTROL_FRAME", "LEDGER_MISMATCH", "RESUME_TIMEOUT", "COMMAND_CONFLICT", "LOCAL_STORE_FULL", "LOCAL_STORE_UNAVAILABLE"]
            },
            "message": { "type": "string", "minLength": 1, "maxLength": 240 }
          },
          "required": ["resumeId", "requestMessageId", "code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["protocolVersion", "messageId", "type", "occurredAt", "payload"],
      "additionalProperties": false
    },
    "DeviceControlMessage": {
      "oneOf": [
        { "$ref": "#/$defs/DeviceWelcomeMessage" },
        { "$ref": "#/$defs/DeviceResumeRequestMessage" },
        { "$ref": "#/$defs/DeviceResumeMessage" },
        { "$ref": "#/$defs/DeviceCommandStatusMessage" },
        { "$ref": "#/$defs/DeviceProjectChangedMessage" },
        { "$ref": "#/$defs/DeviceProjectSavedMessage" },
        { "$ref": "#/$defs/DeviceReadyMessage" },
        { "$ref": "#/$defs/DeviceExecutionProblemMessage" },
        { "$ref": "#/$defs/DeviceProblemMessage" }
      ]
    },
    "DeviceMessage": {
      "oneOf": [
        { "$ref": "#/$defs/DeviceControlMessage" },
        { "$ref": "https://workbench.invalid/schema/project.schema.json#/$defs/ProjectReadCommand" },
        { "$ref": "https://workbench.invalid/schema/project.schema.json#/$defs/ProjectReadReply" },
        { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/ExecutionStartMessage" },
        { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/ExecutionCancelMessage" },
        { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/ExecutionStartDecisionMessage" },
        { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/ExecutionEventsAckMessage" }
      ]
    },
    "DeviceEnvelope": {
      "type": "object",
      "properties": {
        "connectionId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "message": { "$ref": "#/$defs/DeviceMessage" }
      },
      "required": ["connectionId", "message"],
      "additionalProperties": false
    },
    "DeviceBatchEnvelope": {
      "type": "object",
      "properties": {
        "connectionId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "messages": {
          "type": "array",
          "items": { "$ref": "https://workbench.invalid/schema/execution.schema.json#/$defs/ExecutionRunnerMessage" },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": ["connectionId", "messages"],
      "additionalProperties": false
    }
  }
}
