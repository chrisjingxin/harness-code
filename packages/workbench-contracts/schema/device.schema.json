{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schema/device.schema.json",
  "$defs": {
    "ConnectionState": {
      "type": "string",
      "enum": ["offline", "online"]
    },
    "DeviceSummary": {
      "type": "object",
      "properties": {
        "deviceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "ownerUserId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "revokedAt": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" }
          ]
        },
        "connectionState": { "$ref": "#/$defs/ConnectionState" },
        "lastSeenAt": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" }
          ]
        }
      },
      "required": ["deviceId", "ownerUserId", "name", "createdAt", "revokedAt", "connectionState", "lastSeenAt"],
      "additionalProperties": false
    },
    "DeviceSecret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "DeviceRegistrationRequest": {
      "type": "object",
      "properties": {
        "registrationId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "deviceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "installationId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "ledgerId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "secret": { "$ref": "#/$defs/DeviceSecret" }
      },
      "required": ["registrationId", "deviceId", "installationId", "ledgerId", "name", "secret"],
      "additionalProperties": false
    },
    "DeviceRegistrationResponse": {
      "type": "object",
      "properties": {
        "registrationId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "device": { "$ref": "#/$defs/DeviceSummary" }
      },
      "required": ["registrationId", "device"],
      "additionalProperties": false
    },
    "DevicePageCursor": {
      "type": "object",
      "properties": {
        "beforeCreatedAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" },
        "beforeDeviceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
      },
      "required": ["beforeCreatedAt", "beforeDeviceId"],
      "additionalProperties": false
    },
    "DeviceListResponse": {
      "type": "object",
      "properties": {
        "workspaceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "devices": {
          "type": "array",
          "items": { "$ref": "#/$defs/DeviceSummary" },
          "maxItems": 100
        },
        "nextPage": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/DevicePageCursor" }
          ]
        }
      },
      "required": ["workspaceId", "devices", "nextPage"],
      "additionalProperties": false
    },
    "DeviceRevokeRequest": {
      "type": "object",
      "properties": {
        "requestId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" }
      },
      "required": ["requestId"],
      "additionalProperties": false
    },
    "DeviceRevokedResponse": {
      "type": "object",
      "properties": {
        "deviceId": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/Id" },
        "revokedAt": { "$ref": "https://workbench.invalid/schema/platform.schema.json#/$defs/UtcTimestamp" }
      },
      "required": ["deviceId", "revokedAt"],
      "additionalProperties": false
    }
  }
}
