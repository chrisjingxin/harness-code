{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schema/platform.schema.json",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "UtcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "format": "date-time"
    },
    "ProtocolVersion": {
      "const": 1,
      "type": "integer"
    },
    "UserSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9]{0,31}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "id",
        "username",
        "displayName"
      ],
      "additionalProperties": false
    },
    "WorkspaceSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "id",
        "slug",
        "name"
      ],
      "additionalProperties": false
    },
    "MemberSummary": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/$defs/UserSummary"
        }
      },
      "required": [
        "user"
      ],
      "additionalProperties": false
    },
    "CurrentUserResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/$defs/UserSummary"
        },
        "workspaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkspaceSummary"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "user",
        "workspaces"
      ],
      "additionalProperties": false
    },
    "DemoUsersResponse": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UserSummary"
          },
          "maxItems": 3
        }
      },
      "required": [
        "users"
      ],
      "additionalProperties": false
    },
    "WorkspaceListResponse": {
      "type": "object",
      "properties": {
        "workspaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkspaceSummary"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "workspaces"
      ],
      "additionalProperties": false
    },
    "MembersResponse": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/Id"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemberSummary"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "workspaceId",
        "members"
      ],
      "additionalProperties": false
    },
    "DemoLoginRequest": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9]{0,31}$"
        }
      },
      "required": [
        "username"
      ],
      "additionalProperties": false
    },
    "CsrfResponse": {
      "type": "object",
      "properties": {
        "headerName": {
          "const": "X-CSRF-TOKEN",
          "type": "string"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "headerName",
        "token"
      ],
      "additionalProperties": false
    },
    "MetaResponse": {
      "type": "object",
      "properties": {
        "productVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "protocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "loginMode": {
          "const": "demo",
          "type": "string"
        }
      },
      "required": [
        "productVersion",
        "protocolVersion",
        "loginMode"
      ],
      "additionalProperties": false
    },
    "HealthResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UP",
            "DOWN"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_REQUEST",
                "AUTHENTICATION_REQUIRED",
                "DEMO_LOGIN_REJECTED",
                "CSRF_INVALID",
                "REQUEST_SOURCE_REJECTED",
                "RESOURCE_NOT_FOUND",
                "METHOD_NOT_ALLOWED",
                "UNSUPPORTED_MEDIA_TYPE",
                "ALREADY_AUTHENTICATED",
                "PAYLOAD_TOO_LARGE",
                "PROTOCOL_VERSION_UNSUPPORTED",
                "SERVICE_UNAVAILABLE",
                "INTERNAL_ERROR",
                "REQUEST_ID_CONFLICT",
                "CURSOR_AHEAD",
                "PROJECT_NOT_SHARED",
                "TARGET_UNAVAILABLE",
                "EXECUTION_STATE_CONFLICT",
                "REGISTRATION_CONFLICT",
                "DEVICE_AUTHENTICATION_REQUIRED",
                "DEVICE_ACTION_REJECTED",
                "SHARE_VERSION_CONFLICT"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "requestId": {
              "$ref": "#/$defs/Id"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "requestId",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "PlatformMessageHeader": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "messageId": {
          "$ref": "#/$defs/Id"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z]+(?:\\.[a-z]+)+$"
        },
        "occurredAt": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "type",
        "occurredAt"
      ],
      "additionalProperties": false
    }
  }
}
