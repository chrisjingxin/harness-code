      "properties": { "minimum_level": { "$ref": "#/$defs/level" }, "event": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 }, "component": { "type": ["string", "null"], "enum": ["cli", "agent", null] } }
    },
    "queryRunItem": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id"],
      "properties": { "run_id": { "$ref": "#/$defs/safeName" }, "mode": { "enum": ["build", "compose"] }, "outcome": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "queryThreadItem": {
      "type": "object", "additionalProperties": false,
      "required": ["thread_id", "last_activity_ms", "run_count"],
      "properties": { "thread_id": { "$ref": "#/$defs/safeName" }, "last_activity_ms": { "$ref": "#/$defs/nonNegativeInt" }, "run_count": { "$ref": "#/$defs/nonNegativeInt" }, "latest_mode": { "enum": ["build", "compose"] }, "latest_outcome": { "$ref": "#/$defs/safeName" }, "latest_duration_ms": { "$ref": "#/$defs/nonNegativeInt" } }
    },
