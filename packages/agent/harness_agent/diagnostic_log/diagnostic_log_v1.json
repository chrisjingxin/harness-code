      "allOf": [{ "if": { "properties": { "tool_kind": { "const": "mcp" } }, "required": ["tool_kind"] }, "then": { "properties": { "server_name": true }, "required": ["server_name"] } }]
    },
    "toolCompletedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_name", "tool_kind", "outcome", "duration_ms", "result_bytes", "truncated"],
