    },
    "persistenceCompletedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "duration_ms", "row_count"],
      "properties": { "operation": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "row_count": { "$ref": "#/$defs/nullableNonNegativeInt" } }
    },
    "persistenceFailedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "duration_ms", "failure_stage", "error_type", "summary_code"],
      "properties": { "operation": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "failure_stage": { "$ref": "#/$defs/safeName" }, "error_code": { "$ref": "#/$defs/safeName" }, "error_type": { "$ref": "#/$defs/safeName" }, "retryable": { "type": "boolean" }, "summary_code": { "$ref": "#/$defs/safeName" } }
    },
    "presentationReturningFields": {
      "type": "object", "additionalProperties": false,
      "required": ["reason"],
      "properties": { "reason": { "$ref": "#/$defs/safeName" } }
