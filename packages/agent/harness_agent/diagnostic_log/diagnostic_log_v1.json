{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schema/diagnostic-log/v1.json",
  "title": "Harness Diagnostic Log v1",
  "x-harness-diagnostic": {
    "version": 1,
    "max_record_bytes": 8192,
    "events": {
      "logging.started": { "levels": ["info"], "fields": "#/$defs/loggingStartedFields" },
      "logging.reconfigured": { "levels": ["info"], "fields": "#/$defs/loggingReconfiguredFields" },
      "logging.dropped": { "levels": ["warn"], "fields": "#/$defs/loggingDroppedFields" },
      "logging.contract_violation": { "levels": ["warn"], "fields": "#/$defs/loggingContractViolationFields" },
      "logging.writer_failed": { "levels": ["error"], "fields": "#/$defs/errorFields" },
      "logging.stopped": { "levels": ["info", "warn"], "fields": "#/$defs/loggingStoppedFields" },
      "process.started": { "levels": ["info"], "fields": "#/$defs/processStartedFields" },
      "process.stopped": { "levels": ["info", "warn", "error"], "fields": "#/$defs/processStoppedFields" },
      "sidecar.stderr_observed": { "levels": ["warn"], "fields": "#/$defs/stderrObservedFields" },
      "ipc.initialize.completed": { "levels": ["info"], "fields": "#/$defs/ipcInitializeFields" },
      "ipc.request.completed": { "levels": ["debug", "info"], "fields": "#/$defs/ipcRequestCompletedFields" },
      "ipc.request.failed": { "levels": ["warn", "error"], "fields": "#/$defs/ipcRequestFailedFields" },
      "ipc.transport.closed": { "levels": ["info", "warn", "error"], "fields": "#/$defs/ipcTransportClosedFields" },
      "run.started": { "levels": ["info"], "fields": "#/$defs/runStartedFields" },
      "run.completed": { "levels": ["info"], "fields": "#/$defs/runTerminalFields" },
      "run.cancelled": { "levels": ["warn"], "fields": "#/$defs/runCancelledFields" },
      "run.failed": { "levels": ["error"], "fields": "#/$defs/runFailedFields" },
      "runtime.acquire.completed": { "levels": ["debug", "info"], "fields": "#/$defs/runtimeAcquireCompletedFields" },
      "runtime.acquire.failed": { "levels": ["error"], "fields": "#/$defs/durationErrorFields" },
      "runtime.released": { "levels": ["debug", "info", "warn"], "fields": "#/$defs/runtimeReleasedFields" },
      "runtime.pool_snapshot": { "levels": ["debug"], "fields": "#/$defs/runtimePoolFields" },
      "context.build.completed": { "levels": ["info"], "fields": "#/$defs/contextBuildCompletedFields" },
      "context.build.failed": { "levels": ["error"], "fields": "#/$defs/durationErrorFields" },
      "context.compaction.completed": { "levels": ["info"], "fields": "#/$defs/contextCompactionFields" },
      "context.compaction.failed": { "levels": ["error"], "fields": "#/$defs/contextCompactionFailedFields" },
      "catalog.bound": { "levels": ["info"], "fields": "#/$defs/catalogBoundFields" },
      "skill.read": { "levels": ["info"], "fields": "#/$defs/skillReadFields" },
      "hook.started": { "levels": ["debug", "info"], "fields": "#/$defs/hookStartedFields" },
      "hook.completed": { "levels": ["info"], "fields": "#/$defs/hookCompletedFields" },
      "hook.failed": { "levels": ["warn", "error"], "fields": "#/$defs/hookFailedFields" },
      "execution.started": { "levels": ["info"], "fields": "#/$defs/executionStartedFields" },
      "execution.completed": { "levels": ["info"], "fields": "#/$defs/executionCompletedFields" },
      "delegation.usage": { "levels": ["info"], "fields": "#/$defs/delegationUsageFields" },
      "execution.failed": { "levels": ["warn", "error"], "fields": "#/$defs/executionFailedFields" },
      "model.started": { "levels": ["debug", "info"], "fields": "#/$defs/modelStartedFields" },
      "model.completed": { "levels": ["info"], "fields": "#/$defs/modelCompletedFields" },
      "model.retry_scheduled": { "levels": ["debug", "warn"], "fields": "#/$defs/modelRetryFields" },
      "model.failed": { "levels": ["warn", "error"], "fields": "#/$defs/modelFailedFields" },
      "goal.proposal.model.completed": { "levels": ["info"], "fields": "#/$defs/goalProposalCompletedFields" },
      "goal.proposal.model.invalid": { "levels": ["warn"], "fields": "#/$defs/goalProposalInvalidFields" },
      "interaction.started": { "levels": ["info"], "fields": "#/$defs/interactionStartedFields" },
      "interaction.completed": { "levels": ["info", "warn"], "fields": "#/$defs/interactionCompletedFields" },
      "tool.started": { "levels": ["debug", "info"], "fields": "#/$defs/toolStartedFields" },
      "tool.completed": { "levels": ["info"], "fields": "#/$defs/toolCompletedFields" },
      "tool.failed": { "levels": ["warn", "error"], "fields": "#/$defs/toolFailedFields" },
      "mcp.connection.completed": { "levels": ["info"], "fields": "#/$defs/mcpCompletedFields" },
      "mcp.connection.failed": { "levels": ["warn", "error"], "fields": "#/$defs/mcpFailedFields" },
      "mcp.connection.closed": { "levels": ["info", "warn"], "fields": "#/$defs/mcpClosedFields" },
      "persistence.operation.completed": { "levels": ["debug", "info"], "fields": "#/$defs/persistenceCompletedFields" },
      "persistence.operation.failed": { "levels": ["error"], "fields": "#/$defs/persistenceFailedFields" },
      "presentation.handoff.opening": { "levels": ["info"], "fields": "#/$defs/emptyFields" },
      "presentation.renderer.accepted": { "levels": ["info"], "fields": "#/$defs/emptyFields" },
      "presentation.handoff.active": { "levels": ["info"], "fields": "#/$defs/emptyFields" },
      "presentation.handoff.returning": { "levels": ["info"], "fields": "#/$defs/presentationReturningFields" },
      "presentation.gateway.connected": { "levels": ["info"], "fields": "#/$defs/emptyFields" }
    }
  },
  "$ref": "#/$defs/record",
  "$defs": {
    "level": { "enum": ["debug", "info", "warn", "error"] },
    "safeName": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonNegativeInt": { "type": "integer", "minimum": 0 },
    "emptyFields": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "nullableNonNegativeInt": { "type": ["integer", "null"], "minimum": 0 },
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "started_at_ms", "record_sequence"],
      "properties": {
        "pid": { "type": "integer", "minimum": 0 },
        "started_at_ms": { "type": "integer", "minimum": 0 },
        "record_sequence": { "type": "integer", "minimum": 1 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "timestamp_ms", "level", "event", "component", "process", "project_fingerprint", "fields"],
      "properties": {
        "schema_version": { "const": 1 },
        "timestamp_ms": { "type": "integer", "minimum": 0 },
        "level": { "$ref": "#/$defs/level" },
        "event": { "type": "string", "minLength": 1, "maxLength": 120 },
        "component": { "enum": ["cli", "agent"] },
        "process": { "$ref": "#/$defs/processIdentity" },
        "project_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "thread_id": { "$ref": "#/$defs/safeName" },
        "run_id": { "$ref": "#/$defs/safeName" },
        "execution_id": { "$ref": "#/$defs/safeName" },
        "parent_execution_id": { "$ref": "#/$defs/safeName" },
        "agent_id": { "$ref": "#/$defs/safeName" },
        "tool_call_id": { "$ref": "#/$defs/safeName" },
        "event_id": { "$ref": "#/$defs/safeName" },
        "event_sequence": { "type": "integer", "minimum": 0 },
        "activity_id": { "$ref": "#/$defs/safeName" },
        "rpc_request_id": { "$ref": "#/$defs/safeName" },
        "fields": { "type": "object" }
      }
    },
    "loggingStartedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["effective_level", "max_queue_records", "max_queue_bytes", "reserved_queue_records", "reserved_queue_bytes", "max_file_bytes"],
      "properties": { "effective_level": { "$ref": "#/$defs/level" }, "max_queue_records": { "$ref": "#/$defs/nonNegativeInt" }, "max_queue_bytes": { "$ref": "#/$defs/nonNegativeInt" }, "reserved_queue_records": { "$ref": "#/$defs/nonNegativeInt" }, "reserved_queue_bytes": { "$ref": "#/$defs/nonNegativeInt" }, "max_file_bytes": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "loggingReconfiguredFields": {
      "type": "object", "additionalProperties": false,
      "required": ["previous_level", "effective_level", "source"],
      "properties": { "previous_level": { "$ref": "#/$defs/level" }, "effective_level": { "$ref": "#/$defs/level" }, "source": { "enum": ["default", "environment", "config", "initialize"] } }
    },
    "loggingDroppedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["debug_count", "info_count", "warn_count", "error_count", "invalid_count", "oversize_count", "reason"],
      "properties": { "debug_count": { "$ref": "#/$defs/nonNegativeInt" }, "info_count": { "$ref": "#/$defs/nonNegativeInt" }, "warn_count": { "$ref": "#/$defs/nonNegativeInt" }, "error_count": { "$ref": "#/$defs/nonNegativeInt" }, "invalid_count": { "$ref": "#/$defs/nonNegativeInt" }, "oversize_count": { "$ref": "#/$defs/nonNegativeInt" }, "reason": { "enum": ["queue_full", "record_too_large", "contract_violation", "close_timeout", "writer_disabled"] } }
    },
    "loggingContractViolationFields": {
      "type": "object", "additionalProperties": false,
      "required": ["invalid_level_count", "invalid_event_count", "invalid_field_count"],
      "properties": { "invalid_level_count": { "$ref": "#/$defs/nonNegativeInt" }, "invalid_event_count": { "$ref": "#/$defs/nonNegativeInt" }, "invalid_field_count": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "errorFields": {
      "type": "object", "additionalProperties": false,
      "required": ["failure_stage", "error_type", "summary_code"],
      "properties": { "failure_stage": { "$ref": "#/$defs/safeName" }, "error_code": { "$ref": "#/$defs/safeName" }, "error_type": { "$ref": "#/$defs/safeName" }, "retryable": { "type": "boolean" }, "summary_code": { "$ref": "#/$defs/safeName" } }
    },
    "durationErrorFields": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_ms", "failure_stage", "error_type", "summary_code"],
      "properties": { "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "failure_stage": { "$ref": "#/$defs/safeName" }, "error_code": { "$ref": "#/$defs/safeName" }, "error_type": { "$ref": "#/$defs/safeName" }, "retryable": { "type": "boolean" }, "summary_code": { "$ref": "#/$defs/safeName" } }
    },
    "loggingStoppedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["flush_outcome", "queued_count", "written_count", "dropped_count", "duration_ms"],
      "properties": { "flush_outcome": { "enum": ["completed", "timeout", "disabled"] }, "queued_count": { "$ref": "#/$defs/nonNegativeInt" }, "written_count": { "$ref": "#/$defs/nonNegativeInt" }, "dropped_count": { "$ref": "#/$defs/nonNegativeInt" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "processStartedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["command_kind", "runtime_version", "platform", "arch"],
      "properties": { "command_kind": { "$ref": "#/$defs/safeName" }, "runtime_version": { "$ref": "#/$defs/safeName" }, "platform": { "$ref": "#/$defs/safeName" }, "arch": { "$ref": "#/$defs/safeName" } }
    },
    "processStoppedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "exit_code", "duration_ms"],
      "properties": { "outcome": { "enum": ["completed", "cancelled", "failed"] }, "exit_code": { "type": ["integer", "null"] }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "stderrObservedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["bytes", "lines", "truncated"],
      "properties": { "bytes": { "$ref": "#/$defs/nonNegativeInt" }, "lines": { "$ref": "#/$defs/nonNegativeInt" }, "truncated": { "type": "boolean" } }
    },
    "ipcInitializeFields": {
      "type": "object", "additionalProperties": false,
      "required": ["side", "duration_ms", "protocol_minor"],
      "properties": { "side": { "enum": ["client", "server"] }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "protocol_minor": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "ipcRequestCompletedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["side", "method", "duration_ms"],
      "properties": { "side": { "enum": ["client", "server"] }, "method": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "ipcRequestFailedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["side", "method", "duration_ms", "failure_stage", "error_type", "summary_code"],
      "properties": { "side": { "enum": ["client", "server"] }, "method": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "failure_stage": { "$ref": "#/$defs/safeName" }, "error_code": { "$ref": "#/$defs/safeName" }, "error_type": { "$ref": "#/$defs/safeName" }, "retryable": { "type": "boolean" }, "summary_code": { "$ref": "#/$defs/safeName" } }
    },
    "ipcTransportClosedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["side", "outcome", "pending_requests"],
      "properties": { "side": { "enum": ["client", "server"] }, "outcome": { "enum": ["completed", "cancelled", "failed"] }, "pending_requests": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cached_input_tokens"],
      "properties": { "input_tokens": { "$ref": "#/$defs/nullableNonNegativeInt" }, "output_tokens": { "$ref": "#/$defs/nullableNonNegativeInt" }, "cached_input_tokens": { "$ref": "#/$defs/nullableNonNegativeInt" } }
    },
    "runStartedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "resumed", "approval_mode", "model_profile_id"],
      "properties": { "mode": { "enum": ["build", "compose"] }, "resumed": { "type": "boolean" }, "approval_mode": { "$ref": "#/$defs/safeName" }, "model_profile_id": { "$ref": "#/$defs/safeName" } }
    },
    "runTerminalFields": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "duration_ms", "active_ms", "interaction_wait_ms", "retry_wait_ms", "first_visible_activity_ms", "usage"],
      "properties": { "outcome": { "enum": ["completed"] }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "active_ms": { "$ref": "#/$defs/nonNegativeInt" }, "interaction_wait_ms": { "$ref": "#/$defs/nonNegativeInt" }, "retry_wait_ms": { "$ref": "#/$defs/nonNegativeInt" }, "first_visible_activity_ms": { "$ref": "#/$defs/nullableNonNegativeInt" }, "usage": { "$ref": "#/$defs/usage" } }
    },
    "runCancelledFields": {
      "type": "object", "additionalProperties": false,
      "required": ["cancellation_source", "duration_ms", "active_ms", "interaction_wait_ms", "retry_wait_ms"],
      "properties": { "cancellation_source": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "active_ms": { "$ref": "#/$defs/nonNegativeInt" }, "interaction_wait_ms": { "$ref": "#/$defs/nonNegativeInt" }, "retry_wait_ms": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "runFailedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_ms", "active_ms", "interaction_wait_ms", "retry_wait_ms", "failure_stage", "error_type", "summary_code"],
      "properties": { "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "active_ms": { "$ref": "#/$defs/nonNegativeInt" }, "interaction_wait_ms": { "$ref": "#/$defs/nonNegativeInt" }, "retry_wait_ms": { "$ref": "#/$defs/nonNegativeInt" }, "failure_stage": { "$ref": "#/$defs/safeName" }, "error_code": { "$ref": "#/$defs/safeName" }, "error_type": { "$ref": "#/$defs/safeName" }, "retryable": { "type": "boolean" }, "summary_code": { "$ref": "#/$defs/safeName" } }
    },
    "runtimeAcquireCompletedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "queue_ms", "build_ms", "duration_ms"],
      "properties": { "source": { "enum": ["new", "reused"] }, "queue_ms": { "$ref": "#/$defs/nonNegativeInt" }, "build_ms": { "$ref": "#/$defs/nonNegativeInt" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "runtimeReleasedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "duration_ms"],
      "properties": { "outcome": { "enum": ["released", "discarded", "failed"] }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "runtimePoolFields": {
      "type": "object", "additionalProperties": false,
      "required": ["active_count", "idle_count", "waiter_count", "eviction_count"],
      "properties": { "active_count": { "$ref": "#/$defs/nonNegativeInt" }, "idle_count": { "$ref": "#/$defs/nonNegativeInt" }, "waiter_count": { "$ref": "#/$defs/nonNegativeInt" }, "eviction_count": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "contextBuildCompletedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_ms", "message_count", "estimated_tokens", "cache_status"],
      "properties": { "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "message_count": { "$ref": "#/$defs/nonNegativeInt" }, "estimated_tokens": { "$ref": "#/$defs/nonNegativeInt" }, "cache_status": { "enum": ["hit", "miss", "disabled"] } }
    },
    "contextCompactionFields": {
      "type": "object", "additionalProperties": false,
      "required": ["trigger", "action", "duration_ms", "before_estimated_tokens", "after_estimated_tokens", "artifact_count"],
      "properties": { "trigger": { "enum": ["auto", "manual", "overflow"] }, "action": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "before_estimated_tokens": { "$ref": "#/$defs/nonNegativeInt" }, "after_estimated_tokens": { "$ref": "#/$defs/nonNegativeInt" }, "artifact_count": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "contextCompactionFailedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["trigger", "action", "duration_ms", "failure_stage", "error_type", "summary_code"],
      "properties": { "trigger": { "enum": ["auto", "manual", "overflow"] }, "action": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "failure_stage": { "$ref": "#/$defs/safeName" }, "error_code": { "$ref": "#/$defs/safeName" }, "error_type": { "$ref": "#/$defs/safeName" }, "retryable": { "type": "boolean" }, "summary_code": { "$ref": "#/$defs/safeName" } }
    },
    "boundedSafeNames": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeName" }
    },
    "catalogBoundFields": {
      "type": "object", "additionalProperties": false,
      "required": ["skill_count", "mcp_count", "plugin_count"],
      "properties": { "skill_count": { "$ref": "#/$defs/nonNegativeInt" }, "mcp_count": { "$ref": "#/$defs/nonNegativeInt" }, "plugin_count": { "$ref": "#/$defs/nonNegativeInt" }, "skill_ids": { "$ref": "#/$defs/boundedSafeNames" }, "mcp_ids": { "$ref": "#/$defs/boundedSafeNames" }, "plugin_ids": { "$ref": "#/$defs/boundedSafeNames" } }
    },
    "skillReadFields": {
      "type": "object", "additionalProperties": false,
      "required": ["skill_id", "kind"],
      "properties": { "skill_id": { "$ref": "#/$defs/safeName" }, "kind": { "enum": ["body", "resource"] }, "model_round": { "type": "integer", "minimum": 1 } }
    },
    "hookStartedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["plugin_id", "hook_event", "tool_name"],
      "properties": { "plugin_id": { "$ref": "#/$defs/safeName" }, "hook_event": { "enum": ["PreToolUse", "PostToolUse", "PostToolUseFailure", "SubagentStop"] }, "tool_name": { "$ref": "#/$defs/safeName" }, "model_round": { "type": "integer", "minimum": 1 } }
    },
    "hookCompletedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["plugin_id", "hook_event", "tool_name", "outcome", "duration_ms"],
      "properties": { "plugin_id": { "$ref": "#/$defs/safeName" }, "hook_event": { "enum": ["PreToolUse", "PostToolUse", "PostToolUseFailure", "SubagentStop"] }, "tool_name": { "$ref": "#/$defs/safeName" }, "outcome": { "enum": ["allow", "deny", "ok"] }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "model_round": { "type": "integer", "minimum": 1 } }
    },
    "hookFailedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["plugin_id", "hook_event", "tool_name", "duration_ms", "failure_stage", "error_type", "summary_code"],
      "properties": { "plugin_id": { "$ref": "#/$defs/safeName" }, "hook_event": { "enum": ["PreToolUse", "PostToolUse", "PostToolUseFailure", "SubagentStop"] }, "tool_name": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "failure_stage": { "$ref": "#/$defs/safeName" }, "error_code": { "$ref": "#/$defs/safeName" }, "error_type": { "$ref": "#/$defs/safeName" }, "retryable": { "type": "boolean" }, "summary_code": { "$ref": "#/$defs/safeName" }, "model_round": { "type": "integer", "minimum": 1 } }
    },
    "executionStartedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "agent_id"],
      "properties": { "kind": { "enum": ["root", "child", "compose_stage"] }, "agent_id": { "$ref": "#/$defs/safeName" } }
    },
    "executionCompletedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "agent_id", "outcome", "duration_ms"],
      "properties": { "kind": { "enum": ["root", "child", "compose_stage"] }, "agent_id": { "$ref": "#/$defs/safeName" }, "outcome": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "delegationUsageFields": {
      "type": "object", "additionalProperties": false,
      "required": [
        "root_input_tokens",
        "root_output_tokens",
        "root_cached_input_tokens",
        "child_input_tokens",
        "child_output_tokens",
        "child_cached_input_tokens",
        "total_input_tokens",
        "total_output_tokens",
        "total_cached_input_tokens",
        "complete",
        "child_count"
      ],
      "properties": {
        "root_input_tokens": { "$ref": "#/$defs/nonNegativeInt" },
        "root_output_tokens": { "$ref": "#/$defs/nonNegativeInt" },
        "root_cached_input_tokens": { "$ref": "#/$defs/nonNegativeInt" },
        "child_input_tokens": { "$ref": "#/$defs/nonNegativeInt" },
        "child_output_tokens": { "$ref": "#/$defs/nonNegativeInt" },
        "child_cached_input_tokens": { "$ref": "#/$defs/nonNegativeInt" },
        "total_input_tokens": { "$ref": "#/$defs/nonNegativeInt" },
        "total_output_tokens": { "$ref": "#/$defs/nonNegativeInt" },
        "total_cached_input_tokens": { "$ref": "#/$defs/nonNegativeInt" },
        "complete": { "type": "boolean" },
        "child_count": { "$ref": "#/$defs/nonNegativeInt" }
      }
    },
    "executionFailedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "agent_id", "duration_ms", "failure_stage", "error_type", "summary_code"],
