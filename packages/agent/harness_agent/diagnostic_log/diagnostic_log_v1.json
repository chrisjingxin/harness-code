    },
    "queryRunSummary": {
      "type": "object", "additionalProperties": false,
      "properties": { "outcome": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "active_ms": { "$ref": "#/$defs/nonNegativeInt" }, "interaction_wait_ms": { "$ref": "#/$defs/nonNegativeInt" }, "retry_wait_ms": { "$ref": "#/$defs/nonNegativeInt" }, "first_visible_activity_ms": { "$ref": "#/$defs/nullableNonNegativeInt" } }
    },
    "queryDiagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["malformed_count", "invalid_count", "unsupported_schema_count", "partial_line_count", "orphan_active_count", "orphan_active_bytes"],
      "properties": { "malformed_count": { "$ref": "#/$defs/nonNegativeInt" }, "invalid_count": { "$ref": "#/$defs/nonNegativeInt" }, "unsupported_schema_count": { "$ref": "#/$defs/nonNegativeInt" }, "partial_line_count": { "$ref": "#/$defs/nonNegativeInt" }, "orphan_active_count": { "$ref": "#/$defs/nonNegativeInt" }, "orphan_active_bytes": { "$ref": "#/$defs/nonNegativeInt" } }
