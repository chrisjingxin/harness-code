      "allOf": [{ "if": { "properties": { "tool_kind": { "const": "mcp" } }, "required": ["tool_kind"] }, "then": { "properties": { "server_name": true }, "required": ["server_name"] } }]
    },
    "mcpCompletedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["server_name", "server_fingerprint", "transport", "duration_ms", "tool_count"],
      "properties": { "server_name": { "$ref": "#/$defs/safeName" }, "server_fingerprint": { "$ref": "#/$defs/fingerprint" }, "transport": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "tool_count": { "$ref": "#/$defs/nonNegativeInt" } }
    },
    "mcpFailedFields": {
      "type": "object", "additionalProperties": false,
      "required": ["server_name", "server_fingerprint", "transport", "duration_ms", "failure_stage", "error_type", "summary_code"],
      "properties": { "server_name": { "$ref": "#/$defs/safeName" }, "server_fingerprint": { "$ref": "#/$defs/fingerprint" }, "transport": { "$ref": "#/$defs/safeName" }, "duration_ms": { "$ref": "#/$defs/nonNegativeInt" }, "failure_stage": { "$ref": "#/$defs/safeName" }, "error_code": { "$ref": "#/$defs/safeName" }, "error_type": { "$ref": "#/$defs/safeName" }, "retryable": { "type": "boolean" }, "summary_code": { "$ref": "#/$defs/safeName" } }
    },
    "mcpClosedFields": {
      "type": "object", "additionalProperties": false,
