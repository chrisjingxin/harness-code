        "threads": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/queryThreadItem" } },
        "events": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/record" } },
        "matched_count": { "$ref": "#/$defs/nonNegativeInt" },
        "returned_count": { "$ref": "#/$defs/nonNegativeInt" },
        "truncated": { "type": "boolean" },
        "next_cursor": { "type": ["string", "null"], "maxLength": 16384 },
        "diagnostics": { "$ref": "#/$defs/queryDiagnostics" }
      },
      "not": { "type": "object", "properties": { "thread_id": true, "run_id": true }, "required": ["thread_id", "run_id"] }
    }
