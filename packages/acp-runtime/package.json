{
  "name": "@workbench/acp-runtime",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --no-warnings --experimental-loader ../../scripts/typescript_loader.mjs --test tests/*.test.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
