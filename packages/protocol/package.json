{
  "name": "@za38/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./diagnostic-log": "./diagnostic-log/src/index.ts"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "scripts": {
    "generate": "node --no-warnings --experimental-loader ../../scripts/typescript_loader.mjs scripts/generate.ts && node --no-warnings --experimental-loader ../../scripts/typescript_loader.mjs diagnostic-log/scripts/generate.ts",
    "check": "node --no-warnings --experimental-loader ../../scripts/typescript_loader.mjs scripts/generate.ts --check && node --no-warnings --experimental-loader ../../scripts/typescript_loader.mjs diagnostic-log/scripts/generate.ts --check"
  }
}
