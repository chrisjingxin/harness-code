{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schema/platform.schema.json",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "UserId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[0-9a-f]{32}$"
    },
    "UtcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "format": "date-time"
    },
    "ProtocolVersion": {
      "const": 1,
      "type": "integer"
    },
    "UserSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UserId"
        },
        "userNo": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(?:|[0-9a-z][0-9a-z_-]{0,31})$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photo": {
          "type": "string",
          "maxLength": 255
        },
        "orgId": {
          "type": "string",
          "maxLength": 32
        },
        "orgNo": {
          "type": "string",
          "maxLength": 32
        },
        "orgName": {
          "type": "string",
          "maxLength": 128
        },
        "orgPathName": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "id",
        "userNo",
        "userName",
        "photo",
        "orgId",
        "orgNo",
        "orgName",
        "orgPathName"
      ],
      "additionalProperties": false
    },
    "WorkspaceSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "$ref": "#/$defs/WorkspaceRole"
        },
        "memberVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "accessVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "role",
        "memberVersion",
        "accessVersion"
      ],
      "additionalProperties": false
    },
    "MemberSummary": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/$defs/UserSummary"
        },
        "role": {
          "$ref": "#/$defs/WorkspaceRole"
        },
        "status": {
          "enum": [
            "active",
            "removed"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "joinedAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "leftAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "user",
        "role",
        "status",
        "enabled",
        "version",
        "joinedAt",
        "leftAt"
      ],
      "additionalProperties": false
    },
    "CurrentUserResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/$defs/UserSummary"
        },
        "workspaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkspaceSummary"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "user",
        "workspaces"
      ],
      "additionalProperties": false
    },
    "DemoUsersResponse": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UserSummary"
          },
          "maxItems": 50
        }
      },
      "required": [
        "users"
      ],
      "additionalProperties": false
    },
    "WorkspaceListResponse": {
      "type": "object",
      "properties": {
        "workspaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkspaceSummary"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "workspaces"
      ],
      "additionalProperties": false
    },
    "MembersResponse": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/Id"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemberSummary"
          },
          "maxItems": 1000
        },
        "accessVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "workspaceId",
        "members",
        "accessVersion"
      ],
      "additionalProperties": false
    },
    "DemoLoginRequest": {
      "type": "object",
      "properties": {
        "userNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9a-z][0-9a-z_-]{0,31}$"
        }
      },
      "required": [
        "userNo"
      ],
      "additionalProperties": false
    },
    "CsrfResponse": {
      "type": "object",
      "properties": {
        "headerName": {
          "const": "X-CSRF-TOKEN",
          "type": "string"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "headerName",
        "token"
      ],
      "additionalProperties": false
    },
    "MetaResponse": {
      "type": "object",
      "properties": {
        "productVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "protocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "loginMode": {
          "const": "demo",
          "type": "string"
        }
      },
      "required": [
        "productVersion",
        "protocolVersion",
        "loginMode"
      ],
      "additionalProperties": false
    },
    "HealthResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UP",
            "DOWN"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "PlatformMessageHeader": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "messageId": {
          "$ref": "#/$defs/Id"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z]+(?:\\.[a-z]+)+$"
        },
        "occurredAt": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "type",
        "occurredAt"
      ],
      "additionalProperties": false
    },
    "ErrorDetail": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "AUTHENTICATION_REQUIRED",
            "DEMO_LOGIN_REJECTED",
            "CSRF_INVALID",
            "REQUEST_SOURCE_REJECTED",
            "RESOURCE_NOT_FOUND",
            "METHOD_NOT_ALLOWED",
            "UNSUPPORTED_MEDIA_TYPE",
            "ALREADY_AUTHENTICATED",
            "PAYLOAD_TOO_LARGE",
            "PROTOCOL_VERSION_UNSUPPORTED",
            "SERVICE_UNAVAILABLE",
            "INTERNAL_ERROR",
            "REQUEST_ID_CONFLICT",
            "REGISTRATION_CONFLICT",
            "DEVICE_AUTHENTICATION_REQUIRED",
            "DEVICE_ACTION_REJECTED",
            "WORKSPACE_MEMBER_REQUIRED",
            "PROJECT_OWNER_REQUIRED",
            "DEVICE_FORBIDDEN",
            "CONVERSATION_FORBIDDEN",
            "REPOSITORY_CONFLICT",
            "VERSION_CONFLICT",
            "PROJECT_ARCHIVED",
            "REPOSITORY_ARCHIVED",
            "OWNER_CANNOT_LEAVE",
            "SEQUENCE_CONFLICT",
            "SNAPSHOT_EMPTY",
            "SNAPSHOT_TOO_LARGE",
            "TASK_STATE_CONFLICT",
            "TASK_ROLE_REQUIRED",
            "TASK_CONVERSATION_CONFLICT",
            "KNOWLEDGE_ARCHIVED",
            "CONVERSATION_CONFLICT",
            "CONVERSATION_SHARING_STOPPED",
            "WORKSPACE_ADMIN_REQUIRED",
            "LAST_WORKSPACE_ADMIN",
            "TARGET_UNAVAILABLE",
            "HANDOFF_PREVIEW_STALE",
            "HANDOFF_INCOMPLETE",
            "PROJECT_SUCCESSOR_CONFIRMATION_REQUIRED",
            "WORKSPACE_MEMBER_LIMIT",
            "PROPOSAL_STATE_CONFLICT",
            "KNOWLEDGE_BASE_CHANGED",
            "KNOWLEDGE_KEY_EXISTS",
            "IDEMPOTENCY_CONFLICT",
            "RULE_BODY_TOO_LARGE",
            "KNOWLEDGE_METADATA_REQUIRED",
            "REVIEW_REASON_REQUIRED",
            "PROPOSER_MEMBERSHIP_CHANGED",
            "REPOSITORY_UNAVAILABLE"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/Id"
        },
        "retryable": {
          "type": "boolean"
        },
        "expectedSequence": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "code",
        "requestId",
        "retryable"
      ],
      "additionalProperties": false
    },
    "ErrorEnvelope": {
      "type": "object",
      "description": "统一响应包络（失败）：returnCode 为 CLB 分段平台码，body 为错误明细",
      "properties": {
        "returnCode": {
          "type": "string",
          "pattern": "^CLB[0-9]{4}$"
        },
        "errorMsg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "body": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "returnCode",
        "errorMsg",
        "body"
      ],
      "additionalProperties": false
    },
    "BeeResponseEntity": {
      "type": "object",
      "description": "统一响应包络：成功 returnCode=SUC0000、errorMsg=''，body 为业务报文",
      "properties": {
        "returnCode": {
          "type": "string"
        },
        "errorMsg": {
          "type": "string",
          "maxLength": 240
        },
        "body": {}
      },
      "required": [
        "returnCode",
        "errorMsg",
        "body"
      ],
      "additionalProperties": false
    },
    "WorkspaceRole": {
      "enum": [
        "admin",
        "developer"
      ]
    },
    "WorkspaceAccess": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/Id"
        },
        "role": {
          "$ref": "#/$defs/WorkspaceRole"
        },
        "memberVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "accessVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "workspaceId",
        "role",
        "memberVersion",
        "accessVersion"
      ],
      "additionalProperties": false
    },
    "WorkspaceMemberAddRequest": {
      "type": "object",
      "properties": {
        "userNo": {
          "type": "string",
          "pattern": "^[0-9]{1,32}$"
        },
        "requestId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "userNo",
        "requestId"
      ],
      "additionalProperties": false
    },
    "WorkspaceRoleChangeRequest": {
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/WorkspaceRole"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "role",
        "expectedVersion",
        "requestId"
      ],
      "additionalProperties": false
    },
    "WorkspaceMemberChangeResponse": {
      "type": "object",
      "properties": {
        "member": {
          "$ref": "#/$defs/MemberSummary"
        },
        "accessVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "member",
        "accessVersion"
      ],
      "additionalProperties": false
    },
    "WorkspaceRemovalTask": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "task"
        },
        "taskId": {
          "$ref": "#/$defs/Id"
        },
        "projectId": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "todo",
            "doing",
            "review"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "creatorId": {
          "$ref": "#/$defs/UserId"
        },
        "assigneeId": {
          "$ref": "#/$defs/UserId"
        },
        "conversationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "duties": {
          "type": "array",
          "items": {
            "enum": [
              "assignee",
              "creator"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "archived": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "taskId",
        "projectId",
        "title",
        "status",
        "version",
        "creatorId",
        "assigneeId",
        "conversationId",
        "duties",
        "archived"
      ],
      "additionalProperties": false
    },
    "WorkspaceRemovalProject": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "project"
        },
        "projectId": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "archived"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ownerUserId": {
          "$ref": "#/$defs/UserId"
        },
        "targetIsOwner": {
          "type": "boolean"
        },
        "targetIsMember": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "projectId",
        "name",
        "status",
        "version",
        "ownerUserId",
        "targetIsOwner",
        "targetIsMember"
      ],
      "additionalProperties": false
    },
    "WorkspaceRemovalRepository": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "repository"
        },
        "repositoryId": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "archived"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ownerUserId": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "repositoryId",
        "name",
        "status",
        "version",
        "ownerUserId"
      ],
      "additionalProperties": false
    },
    "WorkspaceRemovalPreview": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/Id"
        },
        "targetMember": {
          "$ref": "#/$defs/MemberSummary"
        },
        "accessVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "effectiveAdminCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previewVersion": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/WorkspaceRemovalTask"
              },
              {
                "$ref": "#/$defs/WorkspaceRemovalProject"
              },
              {
                "$ref": "#/$defs/WorkspaceRemovalRepository"
              }
            ]
          }
        },
        "nextAfterId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "type": "object",
          "properties": {
            "tasks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "projects": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "repositories": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "archived": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sharedConversations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "tasks",
            "projects",
            "repositories",
            "archived",
            "sharedConversations"
          ],
          "additionalProperties": false
        },
        "projectEligibility": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "projectId": {
                "$ref": "#/$defs/Id"
              },
              "activeSuccessorUserIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/UserId"
                }
              }
            },
            "required": [
              "projectId",
              "activeSuccessorUserIds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "workspaceId",
        "targetMember",
        "accessVersion",
        "effectiveAdminCount",
        "previewVersion",
        "items",
        "nextAfterId",
        "counts",
        "projectEligibility"
      ],
      "additionalProperties": false
    },
    "WorkspaceMemberRemovalRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "#/$defs/Id"
        },
        "expectedMemberVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previewVersion": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "defaultSuccessorUserId": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserId"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectSuccessors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "projectId": {
                "$ref": "#/$defs/Id"
              },
              "userId": {
                "$ref": "#/$defs/UserId"
              }
            },
            "required": [
              "projectId",
              "userId"
            ],
            "additionalProperties": false
          }
        },
        "taskSuccessors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": {
                "$ref": "#/$defs/Id"
              },
              "userId": {
                "$ref": "#/$defs/UserId"
              }
            },
            "required": [
              "taskId",
              "userId"
            ],
            "additionalProperties": false
          }
        },
        "repositorySuccessors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repositoryId": {
                "$ref": "#/$defs/Id"
              },
              "userId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/UserId"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "repositoryId",
              "userId"
            ],
            "additionalProperties": false
          }
        },
        "addToProjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "projectId": {
                "$ref": "#/$defs/Id"
              },
              "userId": {
                "$ref": "#/$defs/UserId"
              }
            },
            "required": [
              "projectId",
              "userId"
            ],
            "additionalProperties": false
          }
        },
        "confirmResetTasks": {
          "const": true
        },
        "confirmRetainHistory": {
          "const": true
        }
      },
      "required": [
        "requestId",
        "expectedMemberVersion",
        "previewVersion",
        "defaultSuccessorUserId",
        "projectSuccessors",
        "taskSuccessors",
        "repositorySuccessors",
        "addToProjects",
        "confirmResetTasks",
        "confirmRetainHistory"
      ],
      "additionalProperties": false
    },
    "WorkspaceMemberRemovalResponse": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/Id"
        },
        "member": {
          "$ref": "#/$defs/MemberSummary"
        },
        "accessVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestId": {
          "$ref": "#/$defs/Id"
        },
        "transferredTaskCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transferredProjectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transferredRepositoryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unclaimedRepositoryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stoppedConversationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "workspaceId",
        "member",
        "accessVersion",
        "requestId",
        "transferredTaskCount",
        "transferredProjectCount",
        "transferredRepositoryCount",
        "unclaimedRepositoryCount",
        "stoppedConversationCount"
