{
  "name": "za38-cli",
  "private": true,
  "packageManager": "bun@1.2.19",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@za38/cli' build",
    "dev": "bun packages/cli/src/index.ts",
    "deps:install": "bun scripts/dependencies/install.ts",
    "deps:resolve": "bun scripts/dependencies/install.ts --resolve",
    "deps:check": "bun scripts/dependencies/run_python.ts scripts/dependencies/check_dependencies.py",
    "deps:test": "bun test scripts/dependencies/source_policy.test.ts",
    "test": "bun run test:project && bun run deps:test && bun run test:ts && bun run test:py",
    "test:project": "bun test scripts/project",
    "typecheck": "bun run --filter '@za38/cli' typecheck",
    "protocol:generate": "bun run --filter '@za38/protocol' generate",
    "protocol:check": "bun run --filter '@za38/protocol' check",
    "test:ts": "bun run --filter '@za38/cli' test",
    "test:py": "bun run deps:check && bun scripts/dependencies/run_python.ts -m pytest -q packages/agent/tests",
    "docs:check": "bun run scripts/project/index.ts docs:check",
    "tasks:sync": "bun run scripts/project/index.ts tasks:sync",
    "tasks:check": "bun run scripts/project/index.ts tasks:check",
    "task:claim": "bun run scripts/project/index.ts task:claim",
    "task:complete": "bun run scripts/project/index.ts task:complete",
    "version:set": "bun run scripts/project/index.ts version:set",
    "release:check": "bun run scripts/project/index.ts release:check",
    "project:check": "bun run protocol:check && bun run scripts/project/index.ts project:check",
    "test:web:e2e": "bunx playwright test -c packages/cli/tests/e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1"
  },
  "overrides": {
    "fast-uri": "3.1.7"
  },
  "patchedDependencies": {
    "react-devtools-core@7.0.1": "patches/react-devtools-core@7.0.1.patch"
  }
}
