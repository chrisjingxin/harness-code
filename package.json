{
  "name": "za38-cli",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=20",
    "npm": "10.9.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "vite": "8.0.16"
  },
  "scripts": {
    "build": "npm run build --workspace @za38/cli",
    "dev": "node --import tsx packages/cli/src/bin.ts",
    "test": "npm run test:project && npm run test:ts && npm run test:py",
    "test:project": "vitest run --config vitest.config.ts scripts/project",
    "typecheck": "npm run typecheck --workspace @za38/cli",
    "protocol:generate": "npm run generate --workspace @za38/protocol",
    "protocol:check": "npm run check --workspace @za38/protocol",
    "test:ts": "npm run test --workspace @za38/cli",
    "test:py": "cd packages/agent && .venv/bin/python -m pytest -q",
    "docs:check": "node --import tsx scripts/project/index.ts docs:check",
    "tasks:sync": "node --import tsx scripts/project/index.ts tasks:sync",
    "tasks:check": "node --import tsx scripts/project/index.ts tasks:check",
    "task:claim": "node --import tsx scripts/project/index.ts task:claim",
    "task:complete": "node --import tsx scripts/project/index.ts task:complete",
    "version:set": "node --import tsx scripts/project/index.ts version:set",
    "release:check": "node --import tsx scripts/project/index.ts release:check",
    "project:check": "npm run protocol:check && node --import tsx scripts/project/index.ts project:check",
    "test:web:e2e": "playwright test -c packages/cli/tests/e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "tsx": "4.23.13",
    "vitest": "4.1.8"
  }
}
