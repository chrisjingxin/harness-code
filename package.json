{
  "name": "workbench",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/workbench-contracts",
    "packages/runner-core",
    "packages/acp-runtime",
    "packages/project-service",
    "packages/workbench-ui",
    "apps/runner",
    "apps/desktop"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run build --workspace @workbench/contracts --workspace @workbench/runner-core --workspace @workbench/project-service --workspace @workbench/runner --workspace @workbench/ui && npm run dev --workspace @workbench/desktop",
    "typecheck": "npm run typecheck --workspaces",
    "check:boundaries": "node scripts/workbench/check-boundaries.mjs",
    "project:tool": "node --no-warnings --experimental-loader ./scripts/typescript_loader.mjs scripts/project/index.ts",
    "test:project": "node --no-warnings --experimental-loader ./scripts/typescript_loader.mjs --test scripts/project/project-management.test.ts",
    "docs:check": "npm run project:tool -- docs:check",
    "tasks:sync": "npm run project:tool -- tasks:sync",
    "tasks:check": "npm run project:tool -- tasks:check",
    "task:claim": "npm run project:tool -- task:claim",
    "task:complete": "npm run project:tool -- task:complete",
    "version:set": "npm run project:tool -- version:set",
    "release:check": "npm run project:tool -- release:check",
    "project:check": "npm run check:boundaries && npm run project:tool -- project:check",
    "server:build": "node scripts/workbench/server.mjs build",
    "server:migrate": "node scripts/workbench/server.mjs migrate",
    "server:init-demo": "node scripts/workbench/server.mjs init-demo",
    "server:start": "node scripts/workbench/server.mjs start",
    "server:contracts": "node scripts/workbench/server.mjs contracts",
    "contracts:smoke": "node scripts/workbench/check-contracts.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
