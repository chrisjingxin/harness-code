{
  "name": "@workbench/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../scripts/workbench/generate-native-theme.mjs && electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --no-warnings --experimental-loader ../scripts/typescript_loader.mjs --test tests/*.test.ts",
    "dev": "node -e \"import('electron')\" && node ../scripts/workbench/generate-native-theme.mjs && electron-vite dev",
    "preview": "node -e \"import('electron')\" && electron-vite preview --skipBuild",
    "dev:ui-preview": "node ../scripts/workbench/ui-preview.mjs hc205 dev",
    "build:ui-preview": "node ../scripts/workbench/ui-preview.mjs hc205 build",
    "preview:ui": "node ../scripts/workbench/ui-preview.mjs hc205 preview",
    "dev:conversation-preview": "node ../scripts/workbench/ui-preview.mjs hc206 dev",
    "build:conversation-preview": "node ../scripts/workbench/ui-preview.mjs hc206 build",
    "preview:conversation": "node ../scripts/workbench/ui-preview.mjs hc206 preview",
    "dev:project-preview": "node ../scripts/workbench/ui-preview.mjs hc207 dev",
    "build:project-preview": "node ../scripts/workbench/ui-preview.mjs hc207 build",
    "preview:project": "node ../scripts/workbench/ui-preview.mjs hc207 preview",
    "dev:navigation-preview": "node ../scripts/workbench/ui-preview.mjs hc217 dev",
    "build:navigation-preview": "node ../scripts/workbench/ui-preview.mjs hc217 build",
    "preview:navigation": "node ../scripts/workbench/ui-preview.mjs hc217 preview",
    "dev:session-preview": "node ../scripts/workbench/ui-preview.mjs hc218 dev",
    "build:session-preview": "node ../scripts/workbench/ui-preview.mjs hc218 build",
    "preview:session": "node ../scripts/workbench/ui-preview.mjs hc218 preview"
  },
  "dependencies": {
    "@tabler/icons-react": "3.46.0",
    "@workbench/acp-runtime": "0.2.0",
    "@workbench/collaboration-client": "0.2.0",
    "@workbench/harness-acp": "0.2.0",
    "ajv": "8.20.0",
    "marked": "17.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "42.3.0",
    "electron-vite": "4.0.0",
    "vite": "7.3.7",
    "@vitejs/plugin-react": "5.1.4"
  },
  "main": "dist/main/index.js"
}
